/* ==================== 1. HEADER FILES & CONSTANTS ==================== */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define NUM_ROOMS 6
#define MAX_ITEMS 10
#define MAX_HEALTH 100
#define NORTH 0
#define SOUTH 1
#define EAST 2
#define WEST 3

/* ==================== 2. ROOM STRUCTURE ==================== */
typedef struct {
    char name[50], description[300], item[30];
    int exits[4], itemTaken, puzzle, puzzleSolved;
    int ghost, ghostDefeated, damage;
} Room;

/* ==================== 3. PLAYER STRUCTURE ==================== */
typedef struct {
    char name[50], inventory[MAX_ITEMS][30];
    int health, score, currentRoom, itemCount;
} Player;

/* ==================== 4. FUNCTION PROTOTYPES ==================== */
void menu(void);
void initializeRooms(Room r[]);
void initializePlayer(Player *p);
void showRoom(Room r[], Player *p);
void movePlayer(Room r[], Player *p, int direction);
void takeItem(Room r[], Player *p);
void showInventory(Player *p);
void useHealingItem(Player *p);
void solvePuzzle(Room r[], Player *p);
int hasItem(Player *p, const char item[]);

/* ==================== 5. MAIN MENU ==================== */
void menu(void)
{
    int c;
    while (1) {
        printf("\n");
    printf("  #############################################\n");
    printf("  #                                           #\n");
    printf("  #        E S C A P E   T H E                #\n");
    printf("  #      H A U N T E D   M A N S I O N        #\n");
    printf("  #                                           #\n");
    printf("  #############################################\n");
    printf("\n");
    printf("           Don't look behind you...\n\n");
        printf("1. Start Game\n2. Exit\n");
        printf("Enter your choice: ");
        if (scanf("%d", &c) != 1) {
            while (getchar() != '\n');
            printf("Invalid choice.\n");
            continue;
        }
        while (getchar() != '\n');
        if (c == 1) return;
        else if (c == 2) exit(0);
        else printf("Invalid choice. Please try again.\n");
    }
}

void setRoom(Room *r, const char *name, const char *desc)
{
    int i;
    strcpy(r->name, name);
    strcpy(r->description, desc);
    r->item[0] = '\0';
    r->itemTaken = r->puzzle = r->puzzleSolved = 0;
    r->ghost = r->ghostDefeated = r->damage = 0;
    for (i = 0; i < 4; i++) r->exits[i] = -1;
}

void initializeRooms(Room r[])
{
    int i;
    for (i = 0; i < NUM_ROOMS; i++) setRoom(&r[i], "", "");

    setRoom(&r[0], "Entrance Hall",
        "The entrance of the haunted mansion. Return here with the Master Key to escape.");
    r[0].exits[EAST] = 1;

    setRoom(&r[1], "Living Room",
        "An old living room filled with dusty furniture and broken paintings.");
    r[1].exits[WEST] = 0; r[1].exits[SOUTH] = 2;
    strcpy(r[1].item, "Flashlight");

    setRoom(&r[2], "Kitchen",
        "A dark kitchen with rusty utensils scattered everywhere.");
    r[2].exits[NORTH] = 3;
    strcpy(r[2].item, "Med Kit");
    r[2].ghost = 1; r[2].damage = 15;

    setRoom(&r[3], "Library",
        "Ancient books cover every shelf. A mysterious puzzle is hidden here.");
    r[3].exits[SOUTH] = 2; r[3].exits[WEST] = 4;
    r[3].puzzle = 1;

    setRoom(&r[4], "Basement",
        "A cold and dark basement. Strange sounds echo from the walls.");
    r[4].exits[EAST] = 5; r[4].exits[NORTH] = 3;
    strcpy(r[4].item, "Medicine");
    r[4].ghost = 1; r[4].damage = 25;

    setRoom(&r[5], "Secret Chamber",
        "A hidden chamber containing the final secret of the mansion.");
    r[5].exits[WEST] = 4; r[5].exits[NORTH] = 0;
    r[5].puzzle = 1;
}

/* ==================== 7. PLAYER INITIALIZATION ==================== */
void initializePlayer(Player *p)
{
    p->name[0] = '\0';
    p->health = MAX_HEALTH;
    p->score = 0;
    p->currentRoom = 0;
    p->itemCount = 0;
}

/* ==================== 8. ROOM DISPLAY ==================== */
void showRoom(Room r[], Player *p)
{
    Room *x = &r[p->currentRoom];

    printf("\n===============================\n");
    printf("Player: %s | Health: %d/%d | Score: %d\n",
           p->name, p->health, MAX_HEALTH, p->score);
    printf("Room: %s\n%s\n", x->name, x->description);

    if (strlen(x->item) && !x->itemTaken)
        printf("Item Available: %s\n", x->item);
    if (x->puzzle && !x->puzzleSolved)
        printf("A puzzle is waiting to be solved.\n");
    if (x->ghost && !x->ghostDefeated)
        printf("WARNING: A ghost is present!\n");

    printf("Exits:");
    if (x->exits[NORTH] != -1) printf(" North");
    if (x->exits[SOUTH] != -1) printf(" South");
    if (x->exits[EAST] != -1) printf(" East");
    if (x->exits[WEST] != -1) printf(" West");
    printf("\n===============================\n");
}
/* ==================== 9. MOVEMENT & GHOST ATTACKS ==================== */
void movePlayer(Room r[], Player *p, int direction) // Moves player and handles ghosts
{
    int next = r[p->currentRoom].exits[direction], damage; // Gets next room and damage

    if (next == -1) { // Checks if movement is blocked
        printf("\nYou cannot move in that direction.\n"); // Shows movement error
        return; // Stops movement
    }

    if (next == 4 && !hasItem(p, "Flashlight")) { // Checks basement access requirement
        printf("\nIt is too dark to enter the Basement.\n"); // Explains basement restriction
        printf("You need the Flashlight first.\n"); // Requests flashlight
        return; // Stops movement
    }
    if (next == 5 && !hasItem(p, "Silver Key")) { // Checks chamber key requirement
        printf("\nThe Secret Chamber is locked.\n"); // Explains chamber restriction
        printf("You need the Silver Key to enter.\n"); // Requests silver key
        return; // Stops movement
    }

    p->currentRoom = next; // Updates player's room
    printf("\nYou entered the %s.\n", r[next].name); // Announces new room

    if (r[next].ghost && !r[next].ghostDefeated) { // Checks for active ghost
        damage = r[next].damage + rand() % 6; // Calculates random ghost damage
        p->health -= damage; // Reduces player health
        if (p->health < 0) p->health = 0; // Prevents negative health
        r[next].ghostDefeated = 1; // Marks ghost as defeated
        printf("A ghost suddenly attacks you!\n"); // Announces ghost attack
        printf("You lost %d health.\n", damage); // Displays lost health
        if (p->health > 0) printf("The ghost disappears.\n"); // Announces ghost disappearance
    }
}

/* ==================== 10. ITEMS & INVENTORY ==================== */
void takeItem(Room r[], Player *p) // Collects room items
{
    Room *x = &r[p->currentRoom]; // Gets current room

    if (!strlen(x->item)) { // Checks if room has item
        printf("\nThere is no item in this room.\n"); // Shows no-item message
        return; // Stops item collection
    }
    if (x->itemTaken) { // Checks if item was collected
        printf("\nYou already collected this item.\n"); // Shows collected message
        return; // Stops item collection
    }
    if (p->itemCount >= MAX_ITEMS) { // Checks inventory capacity
        printf("\nYour inventory is full.\n"); // Shows full inventory message
        return; // Stops item collection
    }

    strcpy(p->inventory[p->itemCount++], x->item); // Adds item to inventory
    x->itemTaken = 1; // Marks item as collected
    p->score += 10; // Adds item collection score
    printf("\nYou collected: %s\nScore +10\n", x->item); // Announces collected item

    if (!strcmp(x->item, "Flashlight")) // Checks for flashlight
        printf("You can now enter the dark Basement.\n"); // Announces basement access
    else if (!strcmp(x->item, "Silver Key")) // Checks for silver key
        printf("The Secret Chamber can now be opened.\n"); // Announces chamber access
    else if (!strcmp(x->item, "Master Key")) // Checks for master key
        printf("Return to the Entrance Hall to escape!\n"); // Announces escape requirement
}

void showInventory(Player *p) // Displays player's inventory
{
    int i; // Controls inventory display
    if (!p->itemCount) { // Checks if inventory is empty
        printf("\nYour inventory is empty.\n"); // Shows empty inventory message
        return; // Stops inventory display
    }
    printf("\n========== INVENTORY ==========\n"); // Displays inventory heading
    for (i = 0; i < p->itemCount; i++) // Repeats through collected items
        printf("%d. %s\n", i + 1, p->inventory[i]); // Displays each inventory item
    printf("===============================\n"); // Displays inventory border
}

/* ==================== 11. MED KIT / HEALING ==================== */
void useHealingItem(Player *p) // Uses medicine to restore health
{
    int i, choice, heal = 0; // Stores healing information

    if (p->health == MAX_HEALTH) { // Checks if health is full
        printf("\nYour health is already full.\n"); // Shows full health message
        return; // Stops healing
    }

    printf("\nHealing Items:\n"); // Displays healing item heading
    for (i = 0; i < p->itemCount; i++) // Searches inventory items
        if (!strcmp(p->inventory[i], "Medicine") || // Checks for medicine
            !strcmp(p->inventory[i], "Med Kit")) // Checks for Med Kit
            printf("%d. %s\n", i + 1, p->inventory[i]); // Displays healing item

    printf("Enter the item number to use: "); // Asks for item choice
    if (scanf("%d", &choice) != 1) { // Checks for valid input
        while (getchar() != '\n'); // Clears invalid input
        printf("Invalid choice.\n"); // Shows invalid choice
        return; // Stops healing
    }
    while (getchar() != '\n'); // Clears remaining input
    choice--; // Converts choice to index

    if (choice < 0 || choice >= p->itemCount) { // Checks valid inventory index
        printf("Invalid choice.\n"); // Shows invalid choice
        return; // Stops healing
    }

    if (!strcmp(p->inventory[choice], "Medicine")) heal = 20; // Sets medicine healing
    else if (!strcmp(p->inventory[choice], "Med Kit")) heal = 35; // Sets Med Kit healing
    else { // Handles non-healing item
        printf("That item cannot be used for healing.\n"); // Shows healing error
        return; // Stops healing
    }

    p->health += heal; // Adds healing to health
    if (p->health > MAX_HEALTH) p->health = MAX_HEALTH; // Limits health maximum
    printf("\nYou restored %d health.\n", heal); // Displays restored health
    printf("Current Health: %d/%d\n", p->health, MAX_HEALTH); // Displays current health

    for (i = choice; i < p->itemCount - 1; i++) // Shifts remaining items
        strcpy(p->inventory[i], p->inventory[i + 1]); // Removes used item
    p->itemCount--; // Decreases inventory count
}
/* ==================== 12. PUZZLES & KEYS ==================== */
void solvePuzzle(Room r[], Player *p) // Handles puzzle solving
{
    Room *x = &r[p->currentRoom]; // Gets current room
    int answer; // Stores puzzle answer
    if (!x->puzzle) { // Checks for puzzle presence
        printf("\nThere is no puzzle in this room.\n"); // Shows no-puzzle message
        return; // Stops puzzle solving
    }
    if (x->puzzleSolved) { // Checks if puzzle is solved
        printf("\nYou already solved this puzzle.\n"); // Shows solved message
        return; // Stops puzzle solving
    }

    if (p->currentRoom == 3) { // Checks for library puzzle
        printf("\nLIBRARY PUZZLE\nWhich device has keys but no locks?\n"); // Displays library puzzle
        printf("1. Keyboard\n2. Book\n3. Chair\nAnswer: "); // Displays answer choices
        scanf("%d", &answer); while (getchar() != '\n'); // Gets puzzle answer
        if (answer == 1) { // Checks correct library answer
            x->puzzleSolved = 1; // Marks puzzle as solved
            strcpy(x->item, "Silver Key"); // Creates silver key
            p->score += 20; // Adds puzzle score
            printf("Correct! A Silver Key appeared.\n"); // Announces correct answer
        } else printf("Wrong answer. Try again later.\n"); // Shows wrong answer
    } else if (p->currentRoom == 5) { // Checks for chamber puzzle
        printf("\nSECRET CHAMBER PUZZLE\nComplete: 1  3  5  7  ?\n"); // Displays chamber puzzle
        printf("1. 8\n2. 9\n3. 10\nAnswer: "); // Displays answer choices
        scanf("%d", &answer); while (getchar() != '\n'); // Gets puzzle answer
        if (answer == 2) { // Checks correct chamber answer
            x->puzzleSolved = 1; // Marks puzzle as solved
            strcpy(x->item, "Master Key"); // Creates master key
            p->score += 30; // Adds puzzle score
            printf("Correct! The Master Key appeared.\n"); // Announces correct answer
        } else printf("Wrong answer. Try again later.\n"); // Shows wrong answer
    }
}

/* ==================== 13. INVENTORY HELPER ==================== */
int hasItem(Player *p, const char item[]) // Checks whether player has item
{
    int i; // Controls inventory search
    for (i = 0; i < p->itemCount; i++) // Searches all inventory items
        if (!strcmp(p->inventory[i], item)) return 1; // Returns found result
    return 0; // Reports item not found
}

/* ==================== 14. MAIN GAME LOOP & WIN CONDITION ==================== */
int main(void) // Starts the game program
{
    Room rooms[NUM_ROOMS]; // Stores all mansion rooms
    Player player; // Stores player information
    int choice, running = 1; // Stores choice and game status

    srand((unsigned int)time(NULL)); // Starts random number generation
    initializeRooms(rooms); // Initializes mansion rooms
    initializePlayer(&player); // Initializes player data

    menu(); // Displays the main menu

    printf("\nEnter your name: "); // Asks for player name
    fgets(player.name, sizeof(player.name), stdin); // Reads player name
    player.name[strcspn(player.name, "\n")] = '\0'; // Removes newline character

    while (running) { // Repeats the main game loop
        if (player.health <= 0) { // Checks if player has no health
            printf("\n============================\n"); // Displays game-over border
            printf("             GAME OVER\n"); // Displays game-over message
            printf("====================================\n"); // Displays game-over border
            printf("You were defeated by the ghosts.\n"); // Explains game ending
            printf("Final Score: %d\n", player.score); // Displays final score
            break; // Ends the game loop
        }

        showRoom(rooms, &player); // Displays current room
        printf("\n1. Move North\n2. Move South\n3. Move East\n4. Move West\n"); // Displays movement options
        printf("5. Take Item\n6. Show Inventory\n7. Use Healing Item\n"); // Displays item options
        printf("8. Solve Puzzle\n9. Exit Game\n"); // Displays puzzle and exit options
        printf("Enter your choice: "); // Asks for game choice

        if (scanf("%d", &choice) != 1) { // Checks for invalid input
            while (getchar() != '\n'); // Clears invalid input
            printf("Invalid choice.\n"); // Shows invalid choice
            continue; // Restarts game loop
        }
        while (getchar() != '\n'); // Clears remaining input

        switch (choice) { // Selects action from choice
            case 1: movePlayer(rooms, &player, NORTH); break; // Moves player north
            case 2: movePlayer(rooms, &player, SOUTH); break; // Moves player south
            case 3: movePlayer(rooms, &player, EAST); break; // Moves player east
            case 4: movePlayer(rooms, &player, WEST); break; // Moves player west
            case 5: takeItem(rooms, &player); break; // Collects room item
            case 6: showInventory(&player); break; // Shows inventory
            case 7: useHealingItem(&player); break; // Uses healing item
            case 8: solvePuzzle(rooms, &player); break; // Solves room puzzle
            case 9: printf("\nThank you for playing!\n"); running = 0; break; // Exits the game
            default: printf("\nInvalid choice. Please try again.\n"); // Handles invalid choice
        }

        if (player.currentRoom == 0 && hasItem(&player, "Master Key")) { // Checks escape condition
            printf("\n=====================================\n"); // Displays victory border
            printf("         CONGRATULATIONS!\n"); // Displays victory message
            printf("=====================================\n"); // Displays victory border
            printf("%s escaped the Haunted Mansion!\n", player.name); // Announces successful escape
            printf("Final Score: %d\n", player.score); // Displays final score
            printf("Health Left: %d\n", player.health); // Displays remaining health
            printf("Thanks for playing!\n"); // Thanks the player
            running = 0; // Ends the game
        }
    }
    return 0; // Ends program successfully
}
    }
    return 0;

}
